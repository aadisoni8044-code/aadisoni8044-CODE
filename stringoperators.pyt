



name = "aadi"
age = 16 
print("my name is %s and I'm %d"%(name,age))   #4



name = "aadi"
age = 16 
print("my name is {} and I'm {}".format(name,age))   #5



name = "aadi"
age = 16 
print("my name is {0} and I'm {1}".format(name,age))   #6



name = "aadi"
age = 16 
print("my name is {1} and I'm {0}".format(name,age))   #7



name = "aadi"
age = 16 
print("my name is {name} and I'm {age}".format(name='aadi soni',age="18")) #8




name = "aadi"
age = 16 
print(f"my name is {name} and I'm {age}")                                   
print(f"my age after 5 years will be{age+5}")         #9

#-------------------------------------------------


print('''"hello"''')       #1


print("\"Hello\"")         #2


print("Hello\nWorld")     #3


print("Hello\\tWorld")    #4


a = "Hello"
b = 'Python'

print(a+b)